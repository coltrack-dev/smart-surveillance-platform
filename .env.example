# Docker Compose
COMPOSE_PARALLEL_LIMIT=1

# PostgreSQL
POSTGRES_DB=surveillance_db
POSTGRES_USER=surveillance_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=192.168.13.128
POSTGRES_PORT=5432

# Demo host access. Defaults preserve the existing demo address and ports.
KAFKA_ADVERTISED_HOST=192.168.13.128
KAFKA_EXTERNAL_PORT=9092
KAFKA_BIND_ADDRESS=0.0.0.0
MEDIAMTX_BIND_ADDRESS=0.0.0.0
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
GATEWAY_BIND_ADDRESS=0.0.0.0
ANALYTICS_SERVICE_URL=http://host.docker.internal:8097
RECORDING_SERVICE_HOST=192.168.13.128
RECORDING_SERVICE_PORT=8095
STREAM_SOURCE_HOST=192.168.13.128

# Streaming mode secrets (use independently generated values in deployment).
# For local SaaS use, create a private .env.streaming.local; never copy the
# example placeholders into a deployment and never reuse Surveillance DB
# passwords, ingest tokens or signing keys for Streaming.
STREAMING_DB_ADMIN_PASSWORD=
STREAMING_IDENTITY_RUNTIME_PASSWORD=
STREAMING_IDENTITY_MIGRATOR_PASSWORD=
STREAMING_CAMERA_RUNTIME_PASSWORD=
STREAMING_CAMERA_MIGRATOR_PASSWORD=
STREAMING_STREAM_RUNTIME_PASSWORD=
STREAMING_STREAM_MIGRATOR_PASSWORD=
STREAMING_WEBSOCKET_RUNTIME_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
STREAMING_OIDC_BASE_URL=http://localhost:8180
STREAMING_OIDC_ISSUER_URI=http://localhost:8180/realms/streaming
STREAMING_OIDC_REDIRECT_URI=http://localhost:5173/
STREAMING_INTERNAL_JWT_SECRET=
KEYCLOAK_PORT=8180
STREAMING_MEDIA_PUBLISH_USER=stream-publisher
STREAMING_MEDIA_PUBLISH_PASSWORD=
STREAMING_MEDIA_READ_USER=stream-reader
STREAMING_MEDIA_READ_PASSWORD=
STREAMING_GATEWAY_BIND_ADDRESS=127.0.0.1
STREAMING_GATEWAY_PORT=8081
BROADCAST_PLAYBACK_SECRET=
BROADCAST_PLAYBACK_TTL=PT10M
BROADCAST_VIEWER_SESSION_TTL=PT90S
BROADCAST_PLAYER_BASE_URL=http://localhost:5173/watch
BROADCAST_API_URL=http://localhost:8081/api
BROADCAST_PLAYER_ORIGIN=http://localhost:5173
BROADCAST_PLAYER_BIND_ADDRESS=127.0.0.1
BROADCAST_PLAYER_PORT=5173
BROADCAST_RATE_LIMIT_PER_MINUTE=300
# Used by the legacy Stream management-token path; Streaming OIDC mode does
# not use it as user authentication.
BROADCAST_MANAGEMENT_TOKEN=

# Optional Streaming-local settings; defaults keep invitation links disabled.
# Enable link return only on a loopback-only development deployment.
IDENTITY_INVITATIONS_DEVELOPMENT_LINK_ENABLED=false
IDENTITY_INVITATIONS_PUBLIC_BASE_URL=http://localhost:5173
IDENTITY_QUOTAS_DEFAULT_PLAN=FREE
CAMERA_JAVA_OPTS=-Xms128m -Xmx384m
STREAM_JAVA_OPTS=-Xms128m -Xmx384m
IDENTITY_JAVA_OPTS=-Xms96m -Xmx256m
WEBSOCKET_JAVA_OPTS=-Xms96m -Xmx256m
GATEWAY_JAVA_OPTS=-Xms96m -Xmx256m
VIDEO_INGEST_AGENT_ID=streaming-media-node
VIDEO_INGEST_AGENT_LOG_LEVEL=info
VIDEO_INGEST_AGENT_MAX_PIPELINES=8
VIDEO_INGEST_AGENT_MAX_CONCURRENT_PROBES=4
VIDEO_INGEST_AGENT_OUTPUT_HEALTH_INTERVAL_SECONDS=15

# Optional Vue build-time values for non-Compose/manual frontend builds.
# The Streaming Compose build supplies API/OIDC values from the variables above.
VITE_HLS_URL=
VITE_WS_URL=

# Wasabi / S3
# Никогда не сохраняйте настоящие ключи в Git.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_ENDPOINT=https://s3.us-central-1.wasabisys.com
WASABI_REGION=us-central-1
WASABI_BUCKET=des-surveillance

# Recording storage
RECORDING_EXPORT_ENABLED=true
RECORDING_S3_ENABLED=true
# HEALTHY above 20% free, WARNING at 20% or less, CRITICAL at 10% or less.
RECORDING_STORAGE_WARNING_THRESHOLD_PERCENT=20
RECORDING_STORAGE_CRITICAL_THRESHOLD_PERCENT=10
RECORDING_STORAGE_MAXIMUM_LOCAL_SIZE=100GB
RECORDING_STORAGE_CLEANUP_TARGET_PERCENT=90
RECORDING_STORAGE_RETENTION_DAYS=30
RECORDING_STORAGE_MINIMUM_FREE_PERCENT=15
RECORDING_STORAGE_EMERGENCY_FREE_PERCENT=5
RECORDING_STORAGE_MAX_RECORDINGS_PER_RUN=100
# Keep false until preview has been verified. HYBRID local copies remain eligible.
RECORDING_STORAGE_DELETE_LOCAL_ONLY_ENABLED=false

# Application-level S3 quota and retention. Preview is always available;
# actual object deletion requires explicit enablement.
RECORDING_S3_PREFIX=recordings
RECORDING_S3_MAXIMUM_SIZE=500GB
RECORDING_S3_CLEANUP_TARGET_PERCENT=90
RECORDING_S3_RETENTION_DAYS=180
RECORDING_S3_MAX_RECORDINGS_PER_RUN=100
RECORDING_S3_DELETION_ENABLED=false
# Keep false to preserve the S3 backup while a local copy exists.
RECORDING_S3_DELETE_HYBRID_ENABLED=false
RECORDING_S3_REQUIRE_VERIFIED_BEFORE_DELETION=true
# Ignore objects that may still be in flight during reconciliation.
RECORDING_S3_RECONCILIATION_GRACE_PERIOD=5m
RECORDING_S3_AUTOMATIC_CLEANUP_ENABLED=false
RECORDING_S3_AUTOMATIC_CLEANUP_DELAY=1h

# Analytics snapshots
ANALYTICS_SNAPSHOTS_S3_PREFIX=analytics/snapshots

# Inference worker
YOLO_MODEL=/models/yolo11n.pt
YOLO_CONFIDENCE=0.5
LINE_POSITION=0.5

# JPEG quality: 1–100
ANALYTICS_SNAPSHOT_JPEG_QUALITY=75

PUBLIC_PEOPLE_SOURCE_URL=https://example.com/live/playlist.m3u8

KAFKA_BOOTSTRAP_SERVERS=${KAFKA_ADVERTISED_HOST:-192.168.13.128}:${KAFKA_EXTERNAL_PORT:-9092}
RECORDING_SERVICE_URL=http://${RECORDING_SERVICE_HOST:-192.168.13.128}:${RECORDING_SERVICE_PORT:-8095}
STREAM_SOURCE_BASE_URL=rtsp://${STREAM_SOURCE_HOST:-192.168.13.128}:${MEDIAMTX_RTSP_PORT:-8554}

# Base64-encoded 32-byte AES key used to encrypt per-camera RTSP passwords.
# Generate with: openssl rand -base64 32
CAMERA_CREDENTIALS_KEY=

# Rust video ingest agent. Use a long random value outside local development.
VIDEO_INGEST_AGENT_TOKEN=
STREAM_INGEST_AGENT_ENABLED=true
STREAM_INGEST_AGENT_POLL_INTERVAL=1s
VIDEO_INGEST_AGENT_READY_TIMEOUT_SECONDS=30
VIDEO_INGEST_AGENT_OUTPUT_READY_TIMEOUT_SECONDS=15
VIDEO_INGEST_AGENT_OUTPUT_STALL_TIMEOUT_SECONDS=15
