# Docker Compose
COMPOSE_PARALLEL_LIMIT=1

# PostgreSQL
POSTGRES_DB=surveillance_db
POSTGRES_USER=surveillance_user
POSTGRES_PASSWORD=change-me

# Wasabi / S3
# Никогда не сохраняйте настоящие ключи в Git.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_ENDPOINT=https://s3.us-central-1.wasabisys.com
WASABI_REGION=us-central-1
WASABI_BUCKET=des-surveillance

# Recording storage
RECORDING_EXPORT_ENABLED=true
RECORDING_S3_ENABLED=true
# HEALTHY above 20% free, WARNING at 20% or less, CRITICAL at 10% or less.
RECORDING_STORAGE_WARNING_THRESHOLD_PERCENT=20
RECORDING_STORAGE_CRITICAL_THRESHOLD_PERCENT=10
RECORDING_STORAGE_MAXIMUM_LOCAL_SIZE=100GB
RECORDING_STORAGE_CLEANUP_TARGET_PERCENT=90
RECORDING_STORAGE_RETENTION_DAYS=30
RECORDING_STORAGE_MINIMUM_FREE_PERCENT=15
RECORDING_STORAGE_EMERGENCY_FREE_PERCENT=5
RECORDING_STORAGE_MAX_RECORDINGS_PER_RUN=100
# Keep false until preview has been verified. HYBRID local copies remain eligible.
RECORDING_STORAGE_DELETE_LOCAL_ONLY_ENABLED=false

# Analytics snapshots
ANALYTICS_SNAPSHOTS_S3_PREFIX=analytics/snapshots

# Inference worker
YOLO_MODEL=/models/yolo11n.pt
YOLO_CONFIDENCE=0.5
LINE_POSITION=0.5

# JPEG quality: 1–100
ANALYTICS_SNAPSHOT_JPEG_QUALITY=75

PUBLIC_PEOPLE_SOURCE_URL=https://example.com/live/playlist.m3u8

KAFKA_BOOTSTRAP_SERVERS=192.168.13.128:9092
RECORDING_SERVICE_URL=http://192.168.13.128:8095
STREAM_SOURCE_BASE_URL=rtsp://192.168.13.128:8554

# Base64-encoded 32-byte AES key used to encrypt per-camera RTSP passwords.
# Generate with: openssl rand -base64 32
CAMERA_CREDENTIALS_KEY=

# Rust video ingest agent. Use a long random value outside local development.
VIDEO_INGEST_AGENT_TOKEN=change-me
STREAM_INGEST_AGENT_ENABLED=true
STREAM_INGEST_AGENT_POLL_INTERVAL=1s
VIDEO_INGEST_AGENT_READY_TIMEOUT_SECONDS=30
VIDEO_INGEST_AGENT_OUTPUT_READY_TIMEOUT_SECONDS=15
VIDEO_INGEST_AGENT_OUTPUT_STALL_TIMEOUT_SECONDS=15
